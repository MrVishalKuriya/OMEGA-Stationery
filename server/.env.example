# OMEGA Stationery Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g., local daemon or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/omega_stationery

# Redis Connection URL (e.g., local redis-server or cloud Redis)
REDIS_URL=redis://localhost:6379

# Redis Cache TTL in seconds (1 hour = 3600 seconds)
CACHE_TTL_SECONDS=3600
